{
  "$schema": "https://raw.githubusercontent.com/nicegui-app/tauri/main/.schema/capability.schema.json",
  "identifier": "default",
  "description": "Default permissions for SuperIDM",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit"
  ]
}
