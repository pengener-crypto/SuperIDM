<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude download database and temp files from cloud backup -->
        <exclude domain="database" path="superidm.db" />
        <exclude domain="database" path="superidm.db-shm" />
        <exclude domain="database" path="superidm.db-wal" />
        <exclude domain="file" path="download_temp/" />
    </cloud-backup>
    <device-transfer>
        <!-- Allow settings DataStore to transfer between devices -->
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
