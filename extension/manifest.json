{
  "manifest_version": 3,
  "name": "SuperIDM — Download Accelerator",
  "version": "2.4.0",
  "description": "Intercept downloads, grab streaming videos, and accelerate downloads with SuperIDM desktop engine.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "SuperIDM"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "webRequest",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "rpc_token.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
